{
  "name": "@codeproctor/api",
  "version": "0.0.0",
  "private": true,
  "description": "CodeProctor NestJS API",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "pnpm build && node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
