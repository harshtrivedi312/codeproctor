.DS_Store
.claude/agents-generated-backup/
node_modules/
.env

# Dependencies and build output
dist/
.next/
out/
coverage/
*.tsbuildinfo
*.log

# Generated Prisma client (pnpm db:generate; ADR 0009 section 4.2)
apps/api/src/generated/

# Environment files: only .env.example is tracked (NFR-04)
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Local database volumes and data directories
pgdata/
infra/data/
infra/pgdata/

# Database backups and dumps (DB-07): never commit data
*.dump
*.dump.gz
backups/
apps/web/public/monaco/
next-env.d.ts

# Files `next dev` auto-generates in apps/web (the root CLAUDE.md is tracked and must stay)
apps/web/AGENTS.md
apps/web/CLAUDE.md
