# CodeProctor environment template.
#
# Derived from the prompts and ADRs 0001 to 0009; ARC-03 may revise.
# Every value below is a placeholder or a local example. Never put a real secret in this file.
# Copy it to .env (git-ignored) and replace each change-me before using a shared environment.
# Staging, pilot and production load their own secrets from a vault, not from this file (NFR-04).
#
# Each variable notes the step that will use it. Comments sit on their own lines so the file also
# loads with `set -a; . ./.env; set +a` and with docker compose --env-file.

# --- Environment ---
# DB-04 seed guard, Q-28; ARC-03 may revise. Only development may run the demo seed.
APP_ENV=development

# --- Local infrastructure: infra/docker-compose.yml (DB-01) ---
POSTGRES_USER=codeproctor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codeproctor

# --- Database (DB-01, DB-03, DB-05) ---
# Runtime connection used by the API (BE-01, DB-05) and by permission checks. It connects as
# app_user, the DML-only role that the audit_append_only migration creates (ADR 0006 section 7,
# ADR 0009). Use 127.0.0.1, not localhost (ADR 0009 section 4.4, accepted risks). The password here
# must match APP_USER_PASSWORD below. The db:* scripts refuse any host other than this machine.
DATABASE_URL=postgresql://app_user:change-me@127.0.0.1:5432/codeproctor
# Owner-role URL used only by prisma migrate, read through prisma.config.ts (DB-03; ADR 0006
# section 7, ADR 0009 section 4.1). It is the compose POSTGRES_USER role. Only the deploy job holds
# it outside local development.
MIGRATION_DATABASE_URL=postgresql://codeproctor:change-me@127.0.0.1:5432/codeproctor
# Local only: set by infra/scripts/set-app-user-password.mjs after the migrations (pnpm db:migrate
# and pnpm db:reset run it; ADR 0006 section 7.4). It must match the password in DATABASE_URL.
# Staging, pilot and production set it at provisioning, from the vault, never from this file.
APP_USER_PASSWORD=change-me

# --- Redis and BullMQ (DB-01, BE-01) ---
REDIS_URL=redis://127.0.0.1:6379

# --- API and web origins (BE-01) ---
# Port the NestJS API listens on.
API_PORT=4000
# Web app origin allowed by CORS. Local development uses http://localhost:3000.
# Placeholder domains, to be confirmed (D-30):
#   candidates and production: https://assess.yourcompany.com
#   staging:                   https://staging.assess.yourcompany.com
# It must be a bare origin (no path, query or credentials), and an https one when APP_ENV is pilot or
# production: the API refuses to boot otherwise.
WEB_ORIGIN=http://localhost:3000

# --- Authentication secrets (BE-02, BE-07) ---
# Signing secret for staff access JWTs, 15 minutes (BE-02). Generate with: openssl rand -base64 48
# The API refuses to start with a secret shorter than 32 characters.
JWT_ACCESS_SECRET=change-me
# Signs the httpOnly refresh-token cookie (BE-02). Generate with: openssl rand -base64 48
COOKIE_SECRET=change-me
# Signing secret for candidate session JWTs; must differ from the staff secret (BE-07).
# At least 32 characters. Required in pilot and production; candidate routes answer 503 without it.
JWT_CANDIDATE_SECRET=change-me
# One AES-256-GCM key, 32 bytes base64, for TOTP secrets (BE-02).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me
# Key for hashing candidate OTPs with HMAC-SHA256 (BE-07, ADR 0003). At least 32 characters.
# Required in pilot and production.
OTP_PEPPER=change-me
# Wrapping key for the per-session HMAC master key (BE-07, ADR 0013 section 2): AES-256-GCM, 32
# bytes base64, named SESSION_KEY_ENC_KEY_<kid>. SESSION_KEY_ENC_ACTIVE_KID picks the kid for new
# sessions; keep older kids configured until their sessions are destroyed. Production uses a
# KMS-style secret store. Generate with: openssl rand -base64 32
SESSION_KEY_ENC_ACTIVE_KID=k1
SESSION_KEY_ENC_KEY_k1=change-me
# Candidate session JWT lifetime in seconds (60 to 3600). The heartbeat renews it (BE-07).
CANDIDATE_TOKEN_TTL_SECONDS=900
# Seconds after submission that proctor batches are still accepted (ADR 0013 section 2).
PROCTOR_INGEST_GRACE_SECONDS=300

# Issuer label shown in authenticator apps (BE-02).
TOTP_ISSUER=CodeProctor

# --- Runtime behaviour (BE-02) ---
# Number of reverse proxies in front of the API: 0 locally, 1 behind Caddy (FU-BE-08).
# Set the real proxy count on every deployed environment: 1 for Caddy alone, 2 if Cloudflare or a
# load balancer is in front of Caddy as well. With the wrong count the client IP that the throttle
# and the audit log use is wrong, and when APP_ENV is pilot or production the API refuses to boot
# with 0 (FU-BE-97, Backend A #175; DEP-01 sets it in every deployed environment).
# Redis there must run with maxmemory-policy noeviction and AOF, sized with headroom (DL-24):
# eviction could silently drop the lockout counters and the token-revocation markers.
TRUST_PROXY_HOPS=0
# HTTP server timeouts (milliseconds; Backend A #183). These are the defaults. Slow-request limits:
# the header timeout must stay below the request timeout, or the API refuses to boot.
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_REQUEST_TIMEOUT_MS=30000
# Keep-alive: Caddy's upstream keep-alive must be BELOW this value, or Caddy can reuse a connection
# the API has just closed and answer 502.
HTTP_KEEPALIVE_TIMEOUT_MS=65000
HTTP_TIMEOUT_CHECK_INTERVAL_MS=2000
# Serve OpenAPI docs at /api/docs. Off by default; the API refuses true when APP_ENV is pilot or
# production (FU-BE-10).
ENABLE_API_DOCS=false

# --- S3-compatible object storage (BE-09, DB-07) ---
# One S3-compatible interface; only configuration differs between environments (ADR 0001 section 2.1).
# Staging uses Cloudflare R2 with synthetic data only. Pilot and production use AWS S3, where the
# EC2 instance role may replace the access keys. The local object store is decided in ARC-03 or ARC-05.
# Endpoint: empty for AWS S3, https://<account>.r2.cloudflarestorage.com for Cloudflare R2.
S3_ENDPOINT=
# Region: the real AWS region, or auto for Cloudflare R2.
S3_REGION=
S3_FORCE_PATH_STYLE=false
# Sign If-None-Match: * on chunk PUTs so a second PUT to a key fails with 412 (ADR 0013 section 5.5
# control 3). Supported by AWS S3; R2 is not verified (BE-09 spike), so keep false on staging until checked.
S3_CONDITIONAL_WRITES=false
# Access keys are secrets; set both or neither (AWS instance role). Pilot and production require
# S3_REGION and S3_MEDIA_BUCKET, and an https S3_ENDPOINT if one is set.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Private bucket for recordings, ID images, room scans and report PDFs (BE-09).
S3_MEDIA_BUCKET=
# Private bucket for database backups (DB-07).
S3_BACKUP_BUCKET=

# --- Email (BE-06) ---
# One provider key covers every template, including the consent copy, password reset and
# erasure notice. The provider sits behind an interface (Resend first, Brevo possible).
EMAIL_API_KEY=change-me
EMAIL_FROM_ADDRESS=

# --- Code execution (BE-05) ---
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_AUTH_TOKEN=change-me
# Judge0 AUTHZ token (X-Auth-User): required to delete submissions after use.
JUDGE0_AUTHZ_TOKEN=change-me
# Judge0's own Postgres password (infra/judge0).
JUDGE0_DB_PASSWORD=change-me
# Judge0's own Redis (infra/judge0); not the application's REDIS_URL.
JUDGE0_REDIS_PASSWORD=change-me
JUDGE0_REQUEST_TIMEOUT_MS=10000
JUDGE0_POLL_DEADLINE_MS=60000

# --- Error tracking (DEP-01) ---
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_WORKER=

# --- Feature flags ---
# When true the API refuses to serve a consent text without Legal approval (BE-07, ADR 0007).
# Set to true on pilot and production.
REQUIRE_LEGAL_APPROVED_CONSENT=false

# --- Web app (FE-01) ---
# Origin of the API the browser calls. Also the only API origin allowed by the CSP connect-src.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Origins that accept browser uploads (R2 on staging, AWS S3 on pilot and production), comma
# separated. Added to the CSP connect-src. Empty until uploads exist (FE-09 and later).
NEXT_PUBLIC_UPLOAD_ORIGINS=
# Set to "enabled" to serve every API call from MSW mocks (no backend needed). Mock mode only.
NEXT_PUBLIC_API_MOCKING=
# `next build` with NEXT_PUBLIC_API_MOCKING=enabled fails on purpose, whatever NODE_ENV is. Set this
# to "staging-only" for CI and QA throwaway builds only; never in any deployed image.
ALLOW_MOCKING_IN_PRODUCTION_BUILD=
