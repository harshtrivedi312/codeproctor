{
  "name": "codeproctor",
  "version": "0.0.0",
  "private": true,
  "description": "CodeProctor: proctored coding assessment platform for hiring",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:infra": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "dev:infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "dev:infra:reset": "sh infra/scripts/dev-infra-reset",
    "dev:api": "pnpm --filter @codeproctor/api dev",
    "dev:web": "pnpm --filter @codeproctor/web dev",
    "dev:web:mock": "pnpm --filter @codeproctor/web dev:mock",
    "db:generate": "prisma generate",
    "db:migrate": "sh infra/scripts/db-migrate",
    "db:seed": "node infra/scripts/assert-local-db.mjs && prisma db seed",
    "db:reset": "sh infra/scripts/db-reset",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && eslint --no-error-on-unmatched-pattern eslint.config.mjs prisma.config.ts prisma infra/scripts",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "node --test \"infra/scripts/*.test.mjs\" && pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
